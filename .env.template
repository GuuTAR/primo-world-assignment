# Server
PORT=8000

# Features: true or 1 turns a feature on; off when unset.
# ENABLE_MONGODB connects to MongoDB at startup and loads the todos module.
# ENABLE_FIREBASE_AUTH loads the auth and todos modules.
# Todos needs both.
ENABLE_MONGODB=false
ENABLE_FIREBASE_AUTH=false

# MongoDB (required when ENABLE_MONGODB is on)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=testdb

# Firebase (required when ENABLE_FIREBASE_AUTH is on)
FIREBASE_PROJECT_ID=
# Web API key, used by POST /api/v1/auth/signin
FIREBASE_API_KEY=

# Firebase service account (optional, falls back to Application Default Credentials)
FIREBASE_CLIENT_EMAIL=
# Keep the quotes; newlines as \n
FIREBASE_PRIVATE_KEY=""

# RSA key pair (PEM) used by /get-encrypt-data and /get-decrypt-data
# Generate at https://cryptotools.net/rsagen. Keep the quotes; newlines as \n
RSA_PRIVATE_KEY=""
RSA_PUBLIC_KEY=""
